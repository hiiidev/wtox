# Public hostname (DNS must resolve to VPS). Caddy obtains HTTPS certificates.
SITE_DOMAIN=chat.example.com

# Encryption of Tox savedata and temporary message queue (32 random bytes as 64 hex).
# NEVER commit real secrets; back up off-server.
WTOX_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional site entrance password: configure this in your EXISTING .env
# to require a password before any Tox identity/API can be accessed.
# At least 6 characters; there is no length hint on the password page.
# Example: WTOX_ACCESS_PASSWORD='replace-with-a-long-unique-secret'
# An HttpOnly signed browser cookie is stored by hash server-side, expires
# after a year of inactivity and rotates on site launch; devices can be revoked
# individually in Settings after re-entering the site password.
# Upgrading to revocable tokens requires previously trusted devices to log in
# once more. Changing this password invalidates previously authorized devices.
# WARNING: The password must be different from the Tox .tox backup password.
WTOX_ACCESS_PASSWORD=

# Without this variable, site access stays public for backward compatibility;
# personal data still requires a separate .tox identity.
# Backups may separately use their own encryption password.
# No fixed account count: actual concurrency depends on VPS capacity.
WTOX_DATA_DIR=/data

# Tox bootstrap nodes: replace with live entries from https://nodes.tox.chat/
# host:udp_port:64_hex_public_key[:tcp_port] separated by commas
WTOX_BOOTSTRAP=tox.abilinski.com:33445:10C00EB250C3233E343E2AEBA07115A5C28920E9C8D29492F6D00B29049EDC7E,tox1.mf-net.eu:33445:B3E5FA80DC8EBD1149AD2AB35ED8B85BD546DEDE261CA593234C619249419506:3389,tox.initramfs.io:33445:3F0A45A268367C1BEA652F258C85F4A66DA76BCAA667A49E770BCC4917AB6A25:3389

# Native Tox attachments are now encrypted on the existing WTOX_DATA_DIR
# disk volume for up to 7 days, with hourly expiry. No WebDAV is required.
# Preserve WTOX_MASTER_KEY and the persistent Docker data volume on upgrade.

# Security: JSON APIs are capped at 64 KiB; native .tox at ~8 MiB,
# attachment uploads at 5 MiB. The bundled Caddy enforces a 9 MB ceiling.
# If using host Caddy, copy the request_body and security headers in Caddyfile
# into the live host /etc/caddy/Caddyfile and validate before reloading.

# Public hostname (DNS must resolve to VPS). Caddy obtains HTTPS certificates.
SITE_DOMAIN=chat.example.com

# Shared web entrance password: required, at least 6 characters (longer is safer).
# Everybody entering the site must pass this gate before account actions.
WTOX_ACCESS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# Encryption of Tox savedata and temporary message queue (32 random bytes as 64 hex).
# NEVER commit real secrets; back up off-server.
WTOX_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Tox profile creation and import/login are open after the website password.
# No web username or account password is needed.
# No fixed account count: actual concurrency depends on VPS capacity.
WTOX_DATA_DIR=/data

# Tox bootstrap nodes: replace with live entries from https://nodes.tox.chat/
# host:udp_port:64_hex_public_key[:tcp_port] separated by commas
WTOX_BOOTSTRAP=tox.abilinski.com:33445:10C00EB250C3233E343E2AEBA07115A5C28920E9C8D29492F6D00B29049EDC7E,tox1.mf-net.eu:33445:B3E5FA80DC8EBD1149AD2AB35ED8B85BD546DEDE261CA593234C619249419506:3389,tox.initramfs.io:33445:3F0A45A268367C1BEA652F258C85F4A66DA76BCAA667A49E770BCC4917AB6A25:3389

# OPTIONAL encrypted WebDAV attachment archive (not enabled by default).
# Make this existing DAV directory with restricted access before enabling.
# HTTPS ONLY. Do not commit real credentials. Remote objects are ciphertext
# and are automatically deleted after 7 days (cleanup retries hourly).
# WTOX_WEBDAV_URL=https://dav.example.com/remote.php/dav/files/user/wtox/
# WTOX_WEBDAV_USERNAME=your-webdav-username
# WTOX_WEBDAV_PASSWORD=your-app-password
